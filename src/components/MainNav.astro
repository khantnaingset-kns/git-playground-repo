---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	active?: 'services' | 'courses' | 'about' | 'articles';
}

const { active } = Astro.props;

const links = [
	{ label: 'Services', href: '/#services', key: 'services' },
	{ label: 'Courses', href: '/#courses', key: 'courses' },
	{ label: 'About', href: '/#why', key: 'about' },
	{ label: 'Articles', href: '/#articles', key: 'articles' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg">
	<div class="grid h-14 grid-cols-[1fr_auto_1fr] items-center px-4 md:h-16 md:px-8">
		<div class="justify-self-start">
			<Logo href="/" mdSize={36} mdWordSize={20} />
		</div>
		<nav class="hidden items-center gap-2 justify-self-center md:flex">
			{
				links.map((l) => (
					<a
						href={l.href}
						class:list={[
							'rounded-md px-3.5 py-[7px] font-display text-[15px] text-nav-text transition-colors hover:bg-accent/10 hover:text-accent md:text-base',
							active === l.key && 'font-medium',
						]}
					>
						{l.label}
					</a>
				))
			}
		</nav>
		<div class="col-start-3 flex items-center gap-2.5 justify-self-end md:gap-4">
			<ThemeToggle />
			<a
				href="/login"
				class="rounded-md border border-border px-4 py-[7px] text-sm font-medium text-text transition-colors hover:border-text md:px-5 md:py-2 md:text-[15px]"
			>
				Log in
			</a>
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-text transition-colors hover:border-text md:hidden"
			>
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M1 3.5h14M1 8h14M1 12.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>
	<nav id="mobile-menu" class="hidden border-t border-border bg-bg px-4 py-3 md:hidden">
		{
			links.map((l) => (
				<a
					href={l.href}
					class:list={[
						'block rounded-md px-3 py-2.5 font-display text-[15px] text-nav-text transition-colors hover:bg-accent/10 hover:text-accent',
						active === l.key && 'font-medium',
					]}
				>
					{l.label}
				</a>
			))
		}
	</nav>
</header>

<script>
	const btn = document.getElementById('mobile-menu-toggle');
	const menu = document.getElementById('mobile-menu');
	if (btn && menu) {
		btn.addEventListener('click', () => {
			const open = !menu.classList.toggle('hidden');
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		});
		// Close the menu after navigating via an in-page link.
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) {
				menu.classList.add('hidden');
				btn.setAttribute('aria-expanded', 'false');
			}
		});
	}

	// Clicking the logo while already on the home page scrolls back to the
	// top instead of triggering a full page reload.
	const logoLink = document.querySelector<HTMLAnchorElement>('header a[href="/"]');
	if (logoLink && window.location.pathname === '/') {
		logoLink.addEventListener('click', (e) => {
			e.preventDefault();
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
			// Drop any #section hash left over from menu navigation.
			history.replaceState(null, '', '/');
		});
	}
</script>
