---
interface Props {
	size?: number;
	mdSize?: number;
	wordSize?: number;
	mdWordSize?: number;
	withWordmark?: boolean;
	href?: string | null;
}

const {
	size = 28,
	mdSize,
	wordSize = 17,
	mdWordSize,
	withWordmark = true,
	href = '/',
} = Astro.props;

const vars = `--logo-s:${size}px;--logo-s-md:${mdSize ?? size}px;--logo-w:${wordSize}px;--logo-w-md:${mdWordSize ?? wordSize}px`;
const Tag = href ? 'a' : 'div';
const attributes = href ? { href } : {};
---

<Tag {...attributes} class="flex items-center gap-2.5 text-text" style={vars}>
	<img src="/logo-light.svg" alt={withWordmark ? '' : 'FlameOps'} width={size} height={size} class="logo-mark block dark:hidden" />
	<img src="/logo-dark.svg" alt="" width={size} height={size} class="logo-mark hidden dark:block" />
	{withWordmark && <span class="logo-word font-display font-semibold tracking-[-0.01em]">FlameOps</span>}
</Tag>

<style>
	.logo-mark {
		width: var(--logo-s);
		height: var(--logo-s);
	}
	.logo-word {
		font-size: var(--logo-w);
	}
	@media (min-width: 768px) {
		.logo-mark {
			width: var(--logo-s-md);
			height: var(--logo-s-md);
		}
		.logo-word {
			font-size: var(--logo-w-md);
		}
	}
</style>
