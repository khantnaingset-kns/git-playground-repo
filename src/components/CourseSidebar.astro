---
import type { LessonState, Module } from '../data/course';

interface Props {
	modules: Module[];
}

const { modules } = Astro.props;

const marks = { done: '✓', active: '●', todo: '○' } satisfies Record<LessonState, string>;
---

<aside
	class="sticky top-[60px] hidden h-[calc(100vh-60px)] w-[290px] flex-shrink-0 overflow-y-auto border-r border-border py-7 lg:block"
>
	<div class="px-6 pb-5">
		<slot />
	</div>
	{
		modules.map((m) => (
			<div class="pt-3.5 pb-1">
				<div class="mb-2 flex items-center gap-2 px-6">
					<span class="font-mono text-[11px] text-accent">{m.num}</span>
					<span class="text-[13px] font-semibold">{m.title}</span>
				</div>
				{m.lessons.map((l) => (
					<a
						href={l.href}
						class:list={[
							'flex items-center gap-2.5 border-l-2 py-[7px] pr-6 pl-[46px] text-[13px] transition-colors hover:text-text',
							l.state === 'active'
								? 'border-accent bg-accent/[0.06] text-text'
								: 'border-transparent text-muted',
						]}
					>
						<span
							class:list={[
								'w-3.5 font-mono text-[11px]',
								l.state === 'todo' ? 'text-border' : 'text-accent',
							]}
						>
							{marks[l.state]}
						</span>
						<span>{l.title}</span>
					</a>
				))}
			</div>
		))
	}
</aside>
