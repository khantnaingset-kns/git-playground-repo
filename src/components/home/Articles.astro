---
const articles = [
	{
		tag: 'Kubernetes',
		title: 'Stop writing Ingress annotations',
		desc: 'Why the Gateway API is the migration your cluster deserves, and how to do it without downtime.',
		meta: 'Jul 08 · 12 min read',
	},
	{
		tag: 'SRE',
		title: 'Error budgets your team will respect',
		desc: 'SLOs fail when they are imposed. A practical way to negotiate reliability targets that stick.',
		meta: 'Jun 30 · 9 min read',
	},
	{
		tag: 'Delivery',
		title: 'The pipeline is a product',
		desc: 'Treating CI/CD as internal tooling with users, SLAs, and a roadmap — not a pile of YAML.',
		meta: 'Jun 19 · 7 min read',
	},
	{
		tag: 'Platform',
		title: 'Golden paths, not golden cages',
		desc: 'Designing internal platforms that engineers actually want to use instead of route around.',
		meta: 'Jun 05 · 10 min read',
	},
];
---

<!-- Articles -->
<section id="articles" class="border-b border-border">
	<div class="mx-auto max-w-site px-5 py-10 md:px-8 md:py-14">
		<div class="mb-7 flex flex-wrap items-baseline justify-between gap-4">
			<div>
				<div class="mb-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-muted md:text-xs">04 / Articles</div>
				<h2 class="m-0 font-display text-[26px] font-semibold tracking-[-0.01em] md:text-[36px]">From the FlameOps blog</h2>
			</div>
			<a href="#" class="inline-flex items-center gap-2 whitespace-nowrap rounded-md border border-border px-[18px] py-[9px] text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent">
				Visit the blog <span class="font-mono">↗</span>
			</a>
		</div>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 md:gap-6">
			{
				articles.map((a) => (
					<a
						href="#"
						class="flex flex-col gap-3 rounded-card border border-border bg-surface p-5 text-text shadow-card transition-colors hover:border-accent md:p-7"
					>
						<span class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent md:text-xs">{a.tag}</span>
						<span class="font-display text-[17px] font-semibold leading-[1.3] md:text-[20px]">{a.title}</span>
						<span class="text-[13px] leading-[1.55] text-muted md:text-[15px]">{a.desc}</span>
						<span class="mt-auto border-t border-border pt-3.5 font-mono text-[11px] text-muted md:text-xs">{a.meta}</span>
					</a>
				))
			}
		</div>
	</div>
</section>
