---
import Logo from '../Logo.astro';
import HeroTerminal from '../HeroTerminal.astro';
---

<!-- Hero: centered statement with live terminal -->
<section class="border-b border-border">
	<div
		class="mx-auto flex max-w-site flex-col items-center gap-4 px-5 py-10 text-center md:gap-5 md:px-8 md:py-16"
	>
		<Logo href={null} size={48} mdSize={64} withWordmark={false} />
		<div class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">
			DevOps · SRE · Platform Engineering
		</div>
		<h1 class="m-0 max-w-[820px] font-display text-[34px] font-semibold leading-[1.04] tracking-[-0.02em] md:text-[64px]">
			Operations is a craft.<br />Learn it properly.
		</h1>
		<p class="m-0 max-w-[620px] text-base leading-[1.6] text-muted md:text-xl">
			FlameOps trains senior infrastructure engineers through
			documentation-first courses, production-grade labs, and honest
			engineering culture.
		</p>
		<div class="mt-2 w-full max-w-[640px] md:mt-3 md:max-w-[720px]">
			<HeroTerminal />
		</div>
		<div class="mt-2 flex flex-wrap justify-center gap-3">
			<a href="#courses" class="btn-primary">
				Browse courses <span class="font-mono">→</span>
			</a>
			<a href="#services" class="btn-secondary">View services</a>
		</div>
	</div>
</section>
