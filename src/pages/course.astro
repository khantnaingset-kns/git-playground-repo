---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import CourseSidebar from '../components/CourseSidebar.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import { modules, courseMeta } from '../data/course';

const moduleCards = [
	{ num: '01', title: 'Cluster Architecture', desc: 'Control plane internals, node components, and building a cluster from scratch.', meta: '7 lessons · done' },
	{ num: '02', title: 'Workloads & Scheduling', desc: 'Pods, controllers, rollout strategies, and how the scheduler actually decides.', meta: '7 lessons · done' },
	{ num: '03', title: 'Networking & Ingress', desc: 'Services, ingress controllers, the Gateway API, and network policy design.', meta: '8 lessons · in progress' },
	{ num: '04', title: 'Storage', desc: 'Persistent volumes, CSI drivers, and running stateful workloads safely.', meta: '6 lessons' },
	{ num: '05', title: 'GitOps Delivery', desc: 'ArgoCD, repository structure, and progressive delivery with rollouts.', meta: '8 lessons' },
	{ num: '06', title: 'Production Hardening', desc: 'RBAC, policy engines, upgrade strategy, and disaster recovery drills.', meta: '6 lessons' },
];

const resources = [
	{ glyph: '▸', title: 'Session recordings', meta: 'Playlist · 14 recordings so far' },
	{ glyph: '≡', title: 'Course notes repository', meta: 'GitHub · flameops/k8s-platform-notes' },
	{ glyph: '{}', title: 'Lab manifests & starter code', meta: 'GitHub · flameops/k8s-labs' },
	{ glyph: '◈', title: 'Reading list', meta: '18 articles · 3 books' },
];

const facts = [
	{ label: 'Duration', value: '8 weeks' },
	{ label: 'Lessons', value: '42' },
	{ label: 'Level', value: 'Intermediate' },
	{ label: 'Format', value: 'Live + recorded' },
];
---

<Layout title={`${courseMeta.title} — FlameOps`}>
	<div class="flex min-h-screen flex-col bg-bg text-text">
		<AppHeader crumbs={[{ label: 'Courses', href: '/courses' }, { label: courseMeta.title }]} />

		<div class="flex min-h-0 flex-1">
			<CourseSidebar modules={modules}>
				<div class="mb-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
					{courseMeta.code} · {courseMeta.level}
				</div>
				<div class="font-display text-base font-semibold leading-[1.3]">{courseMeta.title}</div>
				<div class="mt-3.5">
					<div class="mb-1.5 flex justify-between font-mono text-[11px] text-muted">
						<span>Progress</span><span>{courseMeta.progressText}</span>
					</div>
					<div class="h-1 overflow-hidden rounded-sm bg-border">
						<div class="h-full bg-accent" style={`width:${courseMeta.progressPct}%`}></div>
					</div>
				</div>
			</CourseSidebar>

			<main class="min-w-0 flex-1">
				<div class="mx-auto max-w-[820px] px-6 pt-14 pb-20 md:px-12">
					<div class="mb-3.5 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">Course overview</div>
					<h1 class="m-0 mb-4 font-display text-[38px] font-semibold leading-[1.1] tracking-[-0.02em]">{courseMeta.title}</h1>
					<p class="m-0 mb-8 text-base leading-[1.65] text-muted">
						An eight-week path from cluster architecture to production-grade GitOps
						delivery. Every module pairs a documentation-style reference with recorded
						sessions and labs on real multi-node clusters.
					</p>

					<div class="mb-12 flex flex-wrap items-center gap-7 rounded-card border border-border bg-surface px-6 py-5 shadow-card">
						{
							facts.map((f, i) => (
								<>
									{i > 0 && <div class="hidden w-px self-stretch bg-border sm:block" />}
									<div>
										<div class="mb-1 font-mono text-[11px] uppercase tracking-[0.1em] text-muted">{f.label}</div>
										<div class="text-sm font-medium">{f.value}</div>
									</div>
								</>
							))
						}
						<div class="flex items-center sm:ml-auto">
							<a href="/lesson" class="btn-primary">
								Continue lesson 3.2 <span class="font-mono">→</span>
							</a>
						</div>
					</div>

					<h2 class="m-0 mb-5 font-display text-[22px] font-semibold tracking-[-0.01em]">Modules</h2>
					<div class="mb-12 flex flex-col gap-3.5">
						{
							moduleCards.map((mc) => (
								<div class="grid grid-cols-[64px_1fr_auto] items-center gap-[18px] rounded-card border border-border bg-surface px-6 py-5 shadow-card transition-colors hover:border-accent">
									<div class="font-mono text-[15px] text-accent">{mc.num}</div>
									<div>
										<div class="mb-1 text-[15px] font-semibold">{mc.title}</div>
										<div class="text-[13px] leading-[1.5] text-muted">{mc.desc}</div>
									</div>
									<div class="text-right font-mono text-[11px] text-muted">{mc.meta}</div>
								</div>
							))
						}
					</div>

					<h2 class="m-0 mb-5 font-display text-[22px] font-semibold tracking-[-0.01em]">Course resources</h2>
					<div class="mb-14 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
						{
							resources.map((r) => (
								<a href="/lesson" class="flex items-start gap-3.5 rounded-card border border-border bg-surface px-5 py-[18px] text-text shadow-card transition-colors hover:border-accent">
									<span class="pt-0.5 font-mono text-xs text-accent">{r.glyph}</span>
									<span>
										<span class="mb-0.5 block text-sm font-medium">{r.title}</span>
										<span class="block text-xs text-muted">{r.meta}</span>
									</span>
								</a>
							))
						}
					</div>

					<PrevNextNav
						previous={{ label: '← Back', title: 'Course catalog', href: '/courses' }}
						next={{ label: 'Continue →', title: '3.2 Ingress Controllers & the Gateway API', href: '/lesson' }}
					/>
				</div>
			</main>
		</div>
	</div>
</Layout>
