---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout title="Sign in — FlameOps">
	<div class="flex min-h-screen flex-col bg-bg text-text">
		<!-- Minimal top bar -->
		<header class="border-b border-border">
			<div class="mx-auto flex h-16 max-w-site items-center justify-between px-6 md:px-8">
				<Logo href="/" mdSize={36} mdWordSize={20} />
				<ThemeToggle />
			</div>
		</header>

		<!-- Centered card -->
		<main class="flex flex-1 items-center justify-center px-6 py-12">
			<div class="w-full max-w-[400px]">
				<div class="flex flex-col items-center gap-5 rounded-xl border border-border bg-surface p-10 text-center shadow-card">
					<Logo href={null} size={48} mdSize={64} withWordmark={false} />
					<div>
						<div class="mb-2 font-display text-2xl font-semibold tracking-[-0.01em]">Sign in to FlameOps</div>
						<div class="text-sm leading-[1.55] text-muted">Access your courses, recordings, and lesson notes.</div>
					</div>
					<a
						href="/course"
						class="flex w-full items-center justify-center gap-3 rounded-lg border border-border bg-bg px-5 py-[13px] text-[15px] font-medium text-text transition-colors hover:border-text"
					>
						<svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"
							><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg
						>
						Continue with Google
					</a>
					<div class="text-xs leading-[1.6] text-muted">
						Access is provisioned by your cohort. By signing in you agree to the
						<a href="#" class="text-accent hover:text-accent-2">terms of use</a>.
					</div>
				</div>
				<div class="mt-6 text-center">
					<span class="font-mono text-xs text-muted"
						>No account? <a href="/" class="text-accent hover:text-accent-2">Browse the academy →</a></span
					>
				</div>
			</div>
		</main>

		<footer class="border-t border-border">
			<div class="mx-auto flex max-w-site justify-center px-6 py-6 md:px-8">
				<span class="font-mono text-[11px] text-muted">© 2026 FlameOps · auth via Google SSO</span>
			</div>
		</footer>
	</div>
</Layout>
